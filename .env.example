# Copie este arquivo para ".env" e ajuste os valores.
# NUNCA versione o arquivo .env real.

# URL do banco (SQLite por padrão; troque por PostgreSQL se desejar)
DATABASE_URL=sqlite:///./financas.db

# Chave usada para assinar os tokens JWT (gere uma aleatória: openssl rand -hex 32)
SECRET_KEY=minha-chave-do-trabalho-uninter-2026-xyz
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Origens permitidas no CORS, separadas por vírgula
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
